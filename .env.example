PORT= 
ADDRESS=
NODE_ENV=
TRUST_PROXY=
DATABASE_URL=
DATABASE_URL_B=
# MongoDB via Cloudflare WARP. Automatic fallback is ON by default: on startup the API
# probes the Atlas shards directly and, only if the ISP is blocking them, auto-enables
# the WARP SOCKS5 proxy and routes ONLY MongoDB through it. Set to 'false' to disable.
MONGO_AUTO_WARP=
# Override the WARP SOCKS5 port used by the automatic fallback (default 40000).
MONGO_WARP_PORT=
# Optional: override the Cloudflare warp-cli path. Auto-detected on PATH and common
# install locations (Windows/macOS/Linux); set only for a non-standard install.
WARP_CLI_PATH=
# Manual override: force MongoDB through a specific SOCKS5 proxy (takes precedence over
# the automatic fallback). Leave blank to rely on automatic detection.
MONGO_PROXY_HOST=
MONGO_PROXY_PORT=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=
COOKIE_SECRET=
COOKIE_DOMAIN=
REDIS_URL=
REDIS_2ND_URL=
REDIS_QUEUE_URL=
REDIS_IO_URL=
EMAIL_SENDER=
EMAIL_FROM=
SENDGRID_API_KEY=
WEBSITE_URL=
ORIGIN_URL=
EXTRA_ORIGIN_URLS=
TMDB_ACCESS_TOKEN=
CRYPTO_SECRET_KEY=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
AZURE_STORAGE_URL=
AZURE_STORAGE_CONNECTION_STRING=
IMAGE_PROXY_URL=
